# Copy this file OUTSIDE the Git checkout, chmod 600, and fill it there.
# See docs/hosting/aws-ec2.md. Values are local operator inventory, not secrets.
AWS_PROFILE=your-sso-profile
AWS_REGION=your-region
INSTANCE_ID=i-example
SSH_USER=ec2-user
SSH_KEY=/absolute/path/to/private-key.pem
PUBLIC_HOST=agent.example.com
