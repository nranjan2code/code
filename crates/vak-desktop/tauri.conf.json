{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "vakcoder",
  "version": "0.2.0",
  "identifier": "dev.vakcoder.desktop",
  "build": {
    "frontendDist": "./ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "vakcoder",
        "width": 1440,
        "height": 900,
        "minWidth": 940,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'self' http://127.0.0.1:* http://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
