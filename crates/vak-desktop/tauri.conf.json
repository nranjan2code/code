{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vakyartha",
  "identifier": "dev.vak.desktop",
  "build": {
    "frontendDist": "../vak-client-ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Vakyartha",
        "visible": false,
        "width": 1440,
        "height": 900,
        "minWidth": 380,
        "minHeight": 480,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'self' http://127.0.0.1:* http://localhost:*; frame-src 'self' http://127.0.0.1:* http://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
