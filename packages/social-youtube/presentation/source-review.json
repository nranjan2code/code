{
  "schema_version": 1,
  "id": "social.youtube.source-review",
  "revision": 1,
  "accepts": [
    "social.youtube.source_review"
  ],
  "root": {
    "primitive": "stack",
    "props": {},
    "children": [
      {
        "primitive": "title",
        "props": {
          "text": {
            "kind": "text",
            "value": "YouTube source review"
          }
        },
        "children": []
      },
      {
        "primitive": "callout",
        "props": {
          "text": {
            "kind": "binding",
            "path": "$.summary",
            "required": false,
            "empty": "omit"
          }
        },
        "children": []
      },
      {
        "primitive": "source_list",
        "props": {},
        "children": [],
        "each": {
          "kind": "binding",
          "path": "$.sources",
          "required": true,
          "empty": "omit"
        },
        "item": {
          "primitive": "section",
          "props": {
            "*": {
              "kind": "binding",
              "path": "$",
              "required": true,
              "empty": "omit"
            }
          },
          "children": []
        }
      },
      {
        "primitive": "takeaway_list",
        "props": {},
        "children": [],
        "each": {
          "kind": "binding",
          "path": "$.takeaways",
          "required": true,
          "empty": "omit"
        },
        "item": {
          "primitive": "section",
          "props": {
            "*": {
              "kind": "binding",
              "path": "$",
              "required": true,
              "empty": "omit"
            }
          },
          "children": []
        }
      }
    ]
  },
  "fallback": {
    "kind": "document"
  },
  "accessibility": {
    "summary": {
      "path": "$.summary",
      "required": false,
      "empty": "empty_text"
    }
  },
  "metadata": {
    "platform": "YouTube",
    "purpose": "YouTube source review",
    "description": "Summarize selected public videos with channel and publication context, keep source links visible, and distinguish metadata from video content. This view puts provenance before synthesis.",
    "version": "1"
  }
}
